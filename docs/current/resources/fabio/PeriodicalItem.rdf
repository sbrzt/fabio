  <rdf:Description rdf:nodeID="n584f50b3c9f447dda23e912c314ed7a7b36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n584f50b3c9f447dda23e912c314ed7a7b41"/>
